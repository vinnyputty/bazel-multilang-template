"""A small Bazel workspace for Rust, Go, and Python."""

module(
    name = "bazel_multilang_template",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.57.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.5.0")
bazel_dep(name = "rules_rust", version = "0.61.0")
bazel_dep(name = "aspect_rules_lint", version = "2.8.0")
bazel_dep(name = "buildifier_prebuilt", version = "6.4.0")
bazel_dep(name = "container_structure_test", version = "1.22.1")

go = use_extension("@rules_go//go:extensions.bzl", "go")
go.toolchain(version = "1.23.0")
use_repo(go, "go_sdk")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")
use_repo(python, "python_3_11")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.82.0"],
)
